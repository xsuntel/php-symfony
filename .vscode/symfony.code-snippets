  "Symfony Service (final + strict_types + promotion)": {
    "scope": "php",
    "prefix": "sym-service",
    "description": "declare(strict_types=1) + final class + readonly 생성자 프로퍼티 프로모션 서비스",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace App\\\\Service${1};",
      "",
      "final class ${2:Name}Service",
      "{",
      "    public function __construct(",
      "        private readonly ${3:DependencyInterface} \\$${4:dependency},",
      "    ) {}",
      "",
      "    public function ${5:handle}(): void",
      "    {",
      "        $0",
      "    }",
      "}",
      ""
    ]
  },

  "Symfony Doctrine Entity": {
    "scope": "php",
    "prefix": "sym-entity",
    "description": "declare(strict_types=1) + Doctrine ORM 속성 매핑 엔티티",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace App\\\\Entity${1};",
      "",
      "use Doctrine\\\\ORM\\\\Mapping as ORM;",
      "",
      "#[ORM\\\\Entity(repositoryClass: ${2:Name}Repository::class)]",
      "class ${2:Name}",
      "{",
      "    #[ORM\\\\Id]",
      "    #[ORM\\\\GeneratedValue]",
      "    #[ORM\\\\Column]",
      "    private ?int \\$id = null;",
      "",
      "    public function getId(): ?int",
      "    {",
      "        return \\$this->id;",
      "    }",
      "$0",
      "}",
      ""
    ]
  },

