  "Stimulus Controller": {
    "scope": "javascript",
    "prefix": "stim-controller",
    "description": "static targets/values/classes 상단 선언 + connect/disconnect 생명주기",
    "body": [
      "import { Controller } from '@hotwired/stimulus'",
      "",
      "export default class extends Controller {",
      "  static targets = ['${1:element}']",
      "  static values = { ${2:open}: Boolean }",
      "  static classes = ['${3:active}']",
      "",
      "  connect() {",
      "    $0",
