{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "App - Console - Assets",
      "type": "shell",
      "command": "./scripts/base/app/symfony/assets.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Console - Cache",
      "type": "shell",
      "command": "./scripts/base/app/symfony/cache.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Console - Database",
      "type": "shell",
      "command": "./scripts/base/app/symfony/database.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Console - Message",
      "type": "shell",
      "command": "./scripts/base/app/symfony/scheduler.sh",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Console - Cache Warmup",
      "type": "shell",
      "command": "php bin/console cache:warmup --env=dev",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Quality - PHPStan",
      "type": "shell",
      "command": "vendor/bin/phpstan analyse",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Quality - PHPStan (Problems)",
      "type": "shell",
      "command": "vendor/bin/phpstan analyse --no-progress --error-format=raw",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": {
        "owner": "phpstan",
        "source": "phpstan",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(.+)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    },
    {
      "label": "App - Quality - PHP-CS-Fixer",
      "type": "shell",
      "command": "vendor/bin/php-cs-fixer fix",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Quality - PHP-CS-Fixer (Check)",
      "type": "shell",
      "command": "vendor/bin/php-cs-fixer fix --dry-run --diff",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Test - PHPUnit",
      "type": "shell",
      "command": "vendor/bin/phpunit",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "App - Tutorial - Symfony Framework",
      "type": "shell",
      "command": "./scripts/tools/ide/tutorial.sh",
