# ----------------------------------------------------------------------------------------------------------------------
# Docker - Docker-Compose                                                   https://docs.docker.com/compose/compose-file
# ----------------------------------------------------------------------------------------------------------------------

# >>>> Project
DOCKER_CONTAINER_NAME=symfony
DOCKER_ENVIRONMENT=dev
DOCKER_WORKDIR="/var/www/app"

# >>>> Profiles                                                             https://docs.docker.com/compose/profiles/
# Compose reads COMPOSE_PROFILES — every service in docker-compose.yml declares `profiles:`, so with no
# value set `up` matches nothing and starts zero containers. `database-alt` (mysql, mongo) is opt-in.
COMPOSE_PROFILES=core,utility

# ----------------------------------------------------------------------------------------------------------------------
# Architecture - Core
# ----------------------------------------------------------------------------------------------------------------------

# >>>> Cache - Redis
REDIS_VERSION=7.0
REDIS_LOCALHOST_PORT=6379

# >>>> Database - PostgreSQL
POSTGRES_VERSION=16
POSTGRES_LOCALHOST_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=symfony
POSTGRES_PASSWORD=!ChangeMe!

# >>>> Message - RabbitMQ
RABBITMQ_VERSION=3.13
RABBITMQ_LOCALHOST_PORT=5672
RABBITMQ_WEBSITE_PORT=15672

# ----------------------------------------------------------------------------------------------------------------------
# Architecture - Database (alternate)                                       profile: database-alt — opt-in, not started
# ----------------------------------------------------------------------------------------------------------------------

# >>>> Database - MySQL                                                                   https://hub.docker.com/_/mysql
MYSQL_VERSION=8.4
MYSQL_LOCALHOST_PORT=3306
MYSQL_DB=app

# >>>> Database - Mongo                                                                   https://hub.docker.com/_/mongo
MONGO_VERSION=8.0
MONGO_LOCALHOST_PORT=27017

# ----------------------------------------------------------------------------------------------------------------------
# Utility
# ----------------------------------------------------------------------------------------------------------------------

# >>>> Database - pgAdmin                                                        https://hub.docker.com/r/dpage/pgadmin4
PGADMIN_VERSION=9.17
PGADMIN_WEBSITE_PORT=5450
PGADMIN_MAIL=pgadmin@example.com
PGADMIN_PW=!ChangeMe!
