# ----------------------------------------------------------------------------------------------------------------------
# Docker - Docker-Compose                                                   https://docs.docker.com/compose/compose-file
# ----------------------------------------------------------------------------------------------------------------------
# >>>> Dockerfile - RabbitMQ                                                           https://hub.docker.com/_/rabbitmq
# >>>> Project
# Stated explicitly rather than relying on the image's guest/guest default, so the credentials in
# scripts/containers/prod/.env.prod.local have a source to match. The AMQP and management ports are
# published on 127.0.0.1 only, so this is dev parity — not a live exposure.
RABBITMQ_DEFAULT_USER=symfony
RABBITMQ_DEFAULT_PASS=!ChangeMe!
RABBITMQ_DEFAULT_VHOST=/
